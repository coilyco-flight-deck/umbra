// A guarded CLI over a real, published MCP server: the protocol's own
// reference implementation, started over stdio. See docs/mcpverb.md.
description "guarded verbs over the MCP reference server"

wrap mcpdemo ops everything {
    mcp stdio {
        command "npx"
        argv "-y" "@modelcontextprotocol/server-everything"
    }

    // Every input below is a flag typed from the server's own JSON Schema.
    // Nothing here restates a shape; the lock carries it.
    can call echo

    can call get-sum {
        describe "add two integers, both bound as typed flags"
    }

    can call get-structured-content {
        // A structured result is addressable, so a postcondition can reject a
        // successful call whose answer was not usable.
        fail-when "temperature == null"
    }

    // A tool that reads the process environment is the obvious thing to close.
    never call get-env

    // The other ten tools are named by no sentence at all. They are absent for
    // exactly the same reason get-env is: only what is granted gets mounted.
}
