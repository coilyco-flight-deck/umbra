corpus ask-tier-npm {
    tool npm
    // umbra#8121: every refusal, stated or uncovered, writes its reject row.
    requires "0a9d50d6319491624129f506597db7c5ef31cc82"
    tool-version "npm" "--version" "11.19.1"
    env "npm_config_offline" "true"
    env "npm_config_update_notifier" "false"
    env "npm_config_fund" "false"
    env "npm_config_audit" "false"
    setup {
        file "package.json" "{\n  \"name\": \"corpus\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"scripts\": {\n    \"test\": \"node -e 0\",\n    \"start\": \"node -e 0\",\n    \"lint\": \"node -e 0\"\n  }\n}\n"
    }

    call "npm ls" class=granted expect=accept rule="can run ls"
    call "npm pack --dry-run" class=granted expect=accept rule="can run pack"
    call "npm config list" class=granted expect=accept rule="can run config list"
    call "npm run lint" class=granted expect=accept rule="can run run"
    call "npm test" class=granted expect=accept rule="can run test"
    call "npm start" class=granted expect=accept rule="can run start"
    call "npm help" class=granted expect=accept rule="can run help"
    call "npm prefix" class=granted expect=accept rule="can run prefix"
    call "npm root" class=granted expect=accept rule="can run root"
    call "npm query :root" class=granted expect=accept rule="can run query"
    call "npm pkg get name" class=granted expect=accept rule="can run pkg get"
    call "npm version --json" class=granted expect=accept rule="can run version"
    call "npm fund" class=granted expect=accept rule="can run fund"
    call "npm exec -- node -v" class=granted expect=accept rule="can run exec"
    call "npm cache verify" class=granted expect=accept rule="can run cache verify"

    call "npm install left-pad" class=never expect=reject rule="never run install"
    call "npm ci" class=never expect=reject rule="never run ci"
    call "npm publish" class=never expect=reject rule="never run publish"
    call "npm unpublish corpus" class=never expect=reject rule="never run unpublish"
    call "npm deprecate corpus msg" class=never expect=reject rule="never run deprecate"
    call "npm login" class=never expect=reject rule="never run login"
    call "npm logout" class=never expect=reject rule="never run logout"
    call "npm adduser" class=never expect=reject rule="never run adduser"
    call "npm dist-tag add corpus@0.1.0 beta" class=never expect=reject rule="never run dist-tag add"
    call "npm owner add someone corpus" class=never expect=reject rule="never run owner add"
    call "npm audit" class=never expect=reject rule="never run audit"
    call "npm update" class=never expect=reject rule="never run update"
    call "npm uninstall left-pad" class=never expect=reject rule="never run uninstall"
    call "npm link" class=never expect=reject rule="never run link"
    call "npm cache clean --force" class=never expect=reject rule="never run cache clean"
    call "npm config set registry https://example.invalid" class=never expect=reject rule="never run config set"
    call "npm pkg set name=other" class=never expect=reject rule="never run pkg set"
    call "npm token create" class=never expect=reject rule="never run token create"
    call "npm outdated" class=never expect=reject rule="never run outdated"
    call "npm search left-pad" class=never expect=reject rule="never run search"
}
