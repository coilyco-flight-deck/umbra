corpus ask-tier-cargo {
    tool cargo
    // umbra#8121: every refusal, stated or uncovered, writes its reject row.
    requires "0a9d50d6319491624129f506597db7c5ef31cc82"
    tool-version "cargo" "--version" "cargo 1.98.1 (797e8a9bc 2026-08-05) (Homebrew)"
    env "CARGO_NET_OFFLINE" "true"
    env "CARGO_TERM_COLOR" "never"
    setup {
        file "Cargo.toml" "[package]\nname = \"corpus\"\nversion = \"0.1.0\"\nedition = \"2021\"\n\n[dependencies]\n"
        file "src/main.rs" "fn main() {\n    println!(\"corpus\");\n}\n\n#[test]\nfn corpus() {}\n"
    }

    call "cargo build" class=granted expect=accept rule="can run build"
    call "cargo check" class=granted expect=accept rule="can run check"
    call "cargo test" class=granted expect=accept rule="can run test"
    call "cargo bench" class=granted expect=accept rule="can run bench"
    call "cargo doc" class=granted expect=accept rule="can run doc"
    call "cargo tree" class=granted expect=accept rule="can run tree"
    call "cargo metadata --format-version 1" class=granted expect=accept rule="can run metadata"
    call "cargo fmt" class=granted expect=accept rule="can run fmt"
    call "cargo clippy" class=granted expect=accept rule="can run clippy"
    call "cargo clean" class=granted expect=accept rule="can run clean"
    call "cargo version" class=granted expect=accept rule="can run version"
    call "cargo pkgid" class=granted expect=accept rule="can run pkgid"
    call "cargo locate-project" class=granted expect=accept rule="can run locate-project"
    call "cargo read-manifest" class=granted expect=accept rule="can run read-manifest"
    call "cargo verify-project" class=granted expect=accept rule="can run verify-project"
    call "cargo generate-lockfile" class=granted expect=accept rule="can run generate-lockfile"
    call "cargo help" class=granted expect=accept rule="can run help"
    call "cargo run" class=granted expect=accept rule="can run run"
    call "cargo rustc" class=granted expect=accept rule="can run rustc"
    call "cargo rustdoc" class=granted expect=accept rule="can run rustdoc"
    call "cargo fix --allow-dirty --allow-no-vcs" class=granted expect=accept rule="can run fix"
    call "cargo update" class=granted expect=accept rule="can run update"
    call "cargo vendor" class=granted expect=accept rule="can run vendor"
    call "cargo package --no-verify --allow-dirty" class=granted expect=accept rule="can run package"

    call "cargo publish" class=never expect=reject rule="never run publish"
    call "cargo install ripgrep" class=never expect=reject rule="never run install"
    call "cargo uninstall ripgrep" class=never expect=reject rule="never run uninstall"
    call "cargo login" class=never expect=reject rule="never run login"
    call "cargo logout" class=never expect=reject rule="never run logout"
    call "cargo owner --list" class=never expect=reject rule="never run owner"
    call "cargo yank --version 0.1.0" class=never expect=reject rule="never run yank"
    call "cargo search serde" class=never expect=reject rule="never run search"
    call "cargo add serde" class=never expect=reject rule="never run add"
    call "cargo remove serde" class=never expect=reject rule="never run remove"
    call "cargo new other" class=never expect=reject rule="never run new"
    call "cargo init" class=never expect=reject rule="never run init"
    call "cargo info serde" class=never expect=reject rule="never run info"
    call "cargo report future-incompatibilities" class=never expect=reject rule="never run report"
}
