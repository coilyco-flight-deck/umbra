description "The cargo half of the ask-tier corpus: one grant per accepted call, one never per refused verb, nothing nested."

wrap corpus cargo {
    exec cargo
    replace

    can run "build"
    can run "check"
    can run "test"
    can run "bench"
    can run "doc"
    can run "tree"
    can run "metadata"
    can run "fmt"
    can run "clippy"
    can run "clean"
    can run "version"
    can run "pkgid"
    can run "locate-project"
    can run "read-manifest"
    can run "verify-project"
    can run "generate-lockfile"
    can run "help"
    can run "run"
    can run "rustc"
    can run "rustdoc"
    can run "fix"
    can run "update"
    can run "vendor"
    can run "package"

    never run "publish"
    never run "install"
    never run "uninstall"
    never run "login"
    never run "logout"
    never run "owner"
    never run "yank"
    never run "search"
    never run "add"
    never run "remove"
    never run "new"
    never run "init"
    never run "info"
    never run "report"
}
