corpus ask-tier-git {
    tool git
    // umbra#8121: every refusal, stated or uncovered, writes its reject row.
    requires "0a9d50d6319491624129f506597db7c5ef31cc82"
    tool-version "git" "--version" "git version 2.50.1 (Apple Git-155)"
    setup {
        git-init
        file "notes.txt" "draft\n"
        git-commit "seed"
        file "notes.txt" "draft\nedited\n"
    }

    call "git status" class=granted expect=accept rule="can run status"
    call "git diff" class=granted expect=accept rule="can run diff"
    call "git log --oneline" class=granted expect=accept rule="can run log"
    call "git shortlog -sn HEAD" class=granted expect=accept rule="can run shortlog"
    call "git show --stat HEAD" class=granted expect=accept rule="can run show"
    call "git ls-files" class=granted expect=accept rule="can run ls-files"
    call "git ls-tree HEAD" class=granted expect=accept rule="can run ls-tree"
    call "git rev-parse HEAD" class=granted expect=accept rule="can run rev-parse"
    call "git rev-list --count HEAD" class=granted expect=accept rule="can run rev-list"
    call "git cat-file -t HEAD" class=granted expect=accept rule="can run cat-file"
    call "git for-each-ref" class=granted expect=accept rule="can run for-each-ref"
    call "git show-ref" class=granted expect=accept rule="can run show-ref"
    call "git symbolic-ref HEAD" class=granted expect=accept rule="can run symbolic-ref"
    call "git describe --always" class=granted expect=accept rule="can run describe"
    call "git name-rev HEAD" class=granted expect=accept rule="can run name-rev"
    call "git merge-base HEAD HEAD" class=granted expect=accept rule="can run merge-base"
    call "git branch --list" class=granted expect=accept rule="can run branch"
    call "git tag --list" class=granted expect=accept rule="can run tag"
    call "git stash list" class=granted expect=accept rule="can run stash list"
    call "git remote -v" class=granted expect=accept rule="can run remote"
    call "git worktree list" class=granted expect=accept rule="can run worktree list"
    call "git notes list" class=granted expect=accept rule="can run notes list"
    call "git config --list" class=granted expect=accept rule="can run config"
    call "git var GIT_AUTHOR_IDENT" class=granted expect=accept rule="can run var"
    call "git count-objects -v" class=granted expect=accept rule="can run count-objects"
    call "git fsck" class=granted expect=accept rule="can run fsck"
    call "git blame notes.txt" class=granted expect=accept rule="can run blame"
    call "git grep draft" class=granted expect=accept rule="can run grep"
    call "git annotate notes.txt" class=granted expect=accept rule="can run annotate"
    call "git whatchanged -1" class=granted expect=accept rule="can run whatchanged"
    call "git diff-files" class=granted expect=accept rule="can run diff-files"
    call "git diff-index HEAD" class=granted expect=accept rule="can run diff-index"
    call "git diff-tree HEAD" class=granted expect=accept rule="can run diff-tree"
    call "git hash-object notes.txt" class=granted expect=accept rule="can run hash-object"
    call "git check-attr -a notes.txt" class=granted expect=accept rule="can run check-attr"
    call "git check-ref-format refs/heads/main" class=granted expect=accept rule="can run check-ref-format"
    call "git column --mode=plain" class=granted expect=accept rule="can run column"
    call "git help" class=granted expect=accept rule="can run help"
    call "git version" class=granted expect=accept rule="can run version"
    call "git format-patch -1 --stdout" class=granted expect=accept rule="can run format-patch"
    call "git archive --format=tar HEAD" class=granted expect=accept rule="can run archive"
    call "git submodule status" class=granted expect=accept rule="can run submodule status"
    call "git maintenance run --task=gc" class=granted expect=accept rule="can run maintenance run"
    call "git gc --auto" class=granted expect=accept rule="can run gc"
    call "git prune --dry-run" class=granted expect=accept rule="can run prune"
    call "git repack -q" class=granted expect=accept rule="can run repack"
    call "git pack-refs" class=granted expect=accept rule="can run pack-refs"
    call "git ls-remote ." class=granted expect=accept rule="can run ls-remote"
    call "git stripspace" class=granted expect=accept rule="can run stripspace"
    call "git interpret-trailers" class=granted expect=accept rule="can run interpret-trailers"
    call "git mktree" class=granted expect=accept rule="can run mktree"
    call "git write-tree" class=granted expect=accept rule="can run write-tree"
    call "git reflog" class=granted expect=accept rule="can run reflog"
    call "git add notes.txt" class=granted expect=accept rule="can run add"
    call "git commit -m corpus" class=granted expect=accept rule="can run commit"

    call "git push" class=never expect=reject rule="never run push"
    call "git pull" class=never expect=reject rule="never run pull"
    call "git fetch" class=never expect=reject rule="never run fetch"
    call "git clone . other" class=never expect=reject rule="never run clone"
    call "git init other" class=never expect=reject rule="never run init"
    call "git rebase main" class=never expect=reject rule="never run rebase"
    call "git reset --hard HEAD" class=never expect=reject rule="never run reset"
    call "git revert HEAD" class=never expect=reject rule="never run revert"
    call "git cherry-pick HEAD" class=never expect=reject rule="never run cherry-pick"
    call "git merge main" class=never expect=reject rule="never run merge"
    call "git rm notes.txt" class=never expect=reject rule="never run rm"
    call "git mv notes.txt other.txt" class=never expect=reject rule="never run mv"
    call "git clean -fd" class=never expect=reject rule="never run clean"
    call "git am patch.mbox" class=never expect=reject rule="never run am"
    call "git apply patch.diff" class=never expect=reject rule="never run apply"
    call "git checkout -b other" class=never expect=reject rule="never run checkout"
    call "git switch -c other" class=never expect=reject rule="never run switch"
    call "git restore notes.txt" class=never expect=reject rule="never run restore"
    call "git bisect start" class=never expect=reject rule="never run bisect start"
    call "git bisect reset" class=never expect=reject rule="never run bisect reset"
    call "git stash drop" class=never expect=reject rule="never run stash drop"
    call "git stash pop" class=never expect=reject rule="never run stash pop"
    call "git stash clear" class=never expect=reject rule="never run stash clear"
    call "git stash push" class=never expect=reject rule="never run stash push"
    call "git worktree add ../other" class=never expect=reject rule="never run worktree add"
    call "git worktree remove ../other" class=never expect=reject rule="never run worktree remove"
    call "git worktree prune" class=never expect=reject rule="never run worktree prune"
    call "git notes add -m corpus" class=never expect=reject rule="never run notes add"
    call "git notes remove HEAD" class=never expect=reject rule="never run notes remove"
    call "git submodule add ../other" class=never expect=reject rule="never run submodule add"
    call "git submodule update --init" class=never expect=reject rule="never run submodule update"
    call "git submodule deinit --all" class=never expect=reject rule="never run submodule deinit"
    call "git maintenance start" class=never expect=reject rule="never run maintenance start"
    call "git maintenance stop" class=never expect=reject rule="never run maintenance stop"
    call "git sparse-checkout set docs" class=never expect=reject rule="never run sparse-checkout set"
    call "git sparse-checkout disable" class=never expect=reject rule="never run sparse-checkout disable"
    call "git filter-branch HEAD" class=never expect=reject rule="never run filter-branch"
    call "git replace HEAD HEAD" class=never expect=reject rule="never run replace"
    call "git update-ref -d HEAD" class=never expect=reject rule="never run update-ref"
    call "git send-email HEAD" class=never expect=reject rule="never run send-email"
    call "git request-pull HEAD ." class=never expect=reject rule="never run request-pull"
    call "git daemon" class=never expect=reject rule="never run daemon"
    call "git instaweb" class=never expect=reject rule="never run instaweb"
    call "git credential fill" class=never expect=reject rule="never run credential"
    call "git range-diff HEAD HEAD" class=never expect=reject rule="never run range-diff"
    call "git cherry" class=never expect=reject rule="never run cherry"
    call "git fast-import" class=never expect=reject rule="never run fast-import"
    call "git fast-export HEAD" class=never expect=reject rule="never run fast-export"
    call "git send-pack ." class=never expect=reject rule="never run send-pack"
    call "git receive-pack ." class=never expect=reject rule="never run receive-pack"
    call "git upload-pack ." class=never expect=reject rule="never run upload-pack"
    call "git update-index --refresh" class=never expect=reject rule="never run update-index"
    call "git read-tree HEAD" class=never expect=reject rule="never run read-tree"
    call "git commit-tree HEAD" class=never expect=reject rule="never run commit-tree"
    call "git prune-packed" class=never expect=reject rule="never run prune-packed"
    call "git unpack-objects" class=never expect=reject rule="never run unpack-objects"
    call "git index-pack pack.pack" class=never expect=reject rule="never run index-pack"
    call "git pack-objects out" class=never expect=reject rule="never run pack-objects"
    call "git bundle create out.bundle HEAD" class=never expect=reject rule="never run bundle create"
    call "git gui" class=never expect=reject rule="never run gui"
}
