description "The git half of the ask-tier corpus: one grant per accepted call, one never per refused verb, nothing nested."

wrap corpus git {
    exec git
    replace

    can run "status"
    can run "diff"
    can run "log"
    can run "shortlog"
    can run "show"
    can run "ls-files"
    can run "ls-tree"
    can run "rev-parse"
    can run "rev-list"
    can run "cat-file"
    can run "for-each-ref"
    can run "show-ref"
    can run "symbolic-ref"
    can run "describe"
    can run "name-rev"
    can run "merge-base"
    can run "branch"
    can run "tag"
    can run "stash list"
    can run "remote"
    can run "worktree list"
    can run "notes list"
    can run "config"
    can run "var"
    can run "count-objects"
    can run "fsck"
    can run "blame"
    can run "grep"
    can run "annotate"
    can run "whatchanged"
    can run "diff-files"
    can run "diff-index"
    can run "diff-tree"
    can run "hash-object"
    can run "check-attr"
    can run "check-ref-format"
    can run "column"
    can run "help"
    can run "version"
    can run "format-patch"
    can run "archive"
    can run "submodule status"
    can run "maintenance run"
    can run "gc"
    can run "prune"
    can run "repack"
    can run "pack-refs"
    can run "ls-remote"
    can run "stripspace"
    can run "interpret-trailers"
    can run "mktree"
    can run "write-tree"
    can run "reflog"
    can run "add"
    can run "commit"

    never run "push"
    never run "pull"
    never run "fetch"
    never run "clone"
    never run "init"
    never run "rebase"
    never run "reset"
    never run "revert"
    never run "cherry-pick"
    never run "merge"
    never run "rm"
    never run "mv"
    never run "clean"
    never run "am"
    never run "apply"
    never run "checkout"
    never run "switch"
    never run "restore"
    never run "bisect start"
    never run "bisect reset"
    never run "stash drop"
    never run "stash pop"
    never run "stash clear"
    never run "stash push"
    never run "worktree add"
    never run "worktree remove"
    never run "worktree prune"
    never run "notes add"
    never run "notes remove"
    never run "submodule add"
    never run "submodule update"
    never run "submodule deinit"
    never run "maintenance start"
    never run "maintenance stop"
    never run "sparse-checkout set"
    never run "sparse-checkout disable"
    never run "filter-branch"
    never run "replace"
    never run "update-ref"
    never run "send-email"
    never run "request-pull"
    never run "daemon"
    never run "instaweb"
    never run "credential"
    never run "range-diff"
    never run "cherry"
    never run "fast-import"
    never run "fast-export"
    never run "send-pack"
    never run "receive-pack"
    never run "upload-pack"
    never run "update-index"
    never run "read-tree"
    never run "commit-tree"
    never run "prune-packed"
    never run "unpack-objects"
    never run "index-pack"
    never run "pack-objects"
    never run "bundle create"
    never run "gui"
}
