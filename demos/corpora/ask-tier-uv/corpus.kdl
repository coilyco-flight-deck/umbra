corpus ask-tier-uv {
    tool uv
    // umbra#8121: every refusal, stated or uncovered, writes its reject row.
    requires "0a9d50d6319491624129f506597db7c5ef31cc82"
    tool-version "uv" "--version" "uv 0.12.13 (Homebrew 2026-09-10 aarch64-apple-darwin)"
    env "UV_OFFLINE" "1"
    env "UV_NO_PROGRESS" "1"
    env "UV_PYTHON_DOWNLOADS" "never"
    setup {
        file "pyproject.toml" "[project]\nname = \"corpus\"\nversion = \"0.1.0\"\nrequires-python = \">=3.9\"\ndependencies = []\n"
        file "main.py" "print(\"corpus\")\n"
    }

    call "uv version" class=granted expect=accept rule="can run version"
    call "uv lock" class=granted expect=accept rule="can run lock"
    call "uv sync" class=granted expect=accept rule="can run sync"
    call "uv tree" class=granted expect=accept rule="can run tree"
    call "uv pip list" class=granted expect=accept rule="can run pip list"
    call "uv pip freeze" class=granted expect=accept rule="can run pip freeze"
    call "uv pip check" class=granted expect=accept rule="can run pip check"
    call "uv python list" class=granted expect=accept rule="can run python list"
    call "uv python find" class=granted expect=accept rule="can run python find"
    call "uv run main.py" class=granted expect=accept rule="can run run"
    call "uv cache dir" class=granted expect=accept rule="can run cache dir"
    call "uv tool list" class=granted expect=accept rule="can run tool list"
    call "uv tool dir" class=granted expect=accept rule="can run tool dir"
    call "uv export" class=granted expect=accept rule="can run export"
    call "uv build" class=granted expect=accept rule="can run build"
    call "uv self version" class=granted expect=accept rule="can run self version"
    call "uv help" class=granted expect=accept rule="can run help"
    call "uv add --frozen corpus-extra" class=granted expect=accept rule="can run add"

    call "uv publish" class=never expect=reject rule="never run publish"
    call "uv pip install requests" class=never expect=reject rule="never run pip install"
    call "uv pip uninstall requests" class=never expect=reject rule="never run pip uninstall"
    call "uv pip sync requirements.txt" class=never expect=reject rule="never run pip sync"
    call "uv tool install ruff" class=never expect=reject rule="never run tool install"
    call "uv tool uninstall ruff" class=never expect=reject rule="never run tool uninstall"
    call "uv tool upgrade ruff" class=never expect=reject rule="never run tool upgrade"
    call "uv tool run ruff" class=never expect=reject rule="never run tool run"
    call "uv python install 3.13" class=never expect=reject rule="never run python install"
    call "uv python uninstall 3.13" class=never expect=reject rule="never run python uninstall"
    call "uv python pin 3.13" class=never expect=reject rule="never run python pin"
    call "uv self update" class=never expect=reject rule="never run self update"
    call "uv remove corpus-extra" class=never expect=reject rule="never run remove"
    call "uv init other" class=never expect=reject rule="never run init"
    call "uv venv" class=never expect=reject rule="never run venv"
    call "uv cache clean" class=never expect=reject rule="never run cache clean"
    call "uv cache prune" class=never expect=reject rule="never run cache prune"
}
