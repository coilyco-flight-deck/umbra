demo git-read-only {
    tool git
    state minted
    formats kdl yaml toml
    frame cols=80 rows=14
    setup {
        git-init
        file "notes.txt" "draft\n"
    }
    step "git status --short" exit=0 shows="notes.txt"
    step "git push" exit=2 shows="is withheld"
    step "git commit --no-verify -m wip" exit=2 shows="is denied"
    step "git fetch" exit=2 shows="is not granted"
}
